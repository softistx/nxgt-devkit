{
	"name": "@nxgt/msw-graphql",
	"version": "0.1.1",
	"description": "Mock a GraphQL API with msw by executing the real operations against your schema: one executor for the browser worker and the Node server, a control channel to reset, fail or reseed it from an e2e test, and a dual Vite/Node SDL loader",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"CHANGELOG.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"import": "./dist/schema/index.js",
			"default": "./dist/schema/index.js"
		},
		"./sdl": {
			"types": "./dist/sdl/index.d.ts",
			"import": "./dist/sdl/index.js",
			"default": "./dist/sdl/index.js"
		},
		"./browser": {
			"types": "./dist/browser/index.d.ts",
			"import": "./dist/browser/index.js",
			"default": "./dist/browser/index.js"
		},
		"./node": {
			"types": "./dist/node/index.d.ts",
			"import": "./dist/node/index.js",
			"default": "./dist/node/index.js"
		},
		"./fetch": {
			"types": "./dist/fetch/index.d.ts",
			"import": "./dist/fetch/index.js",
			"default": "./dist/fetch/index.js"
		},
		"./response": {
			"types": "./dist/response/index.d.ts",
			"import": "./dist/response/index.js",
			"default": "./dist/response/index.js"
		},
		"./control": {
			"types": "./dist/control/index.d.ts",
			"import": "./dist/control/index.js",
			"default": "./dist/control/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"msw",
		"graphql",
		"mock",
		"mocking",
		"e2e",
		"playwright",
		"testing"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-devkit.git",
		"directory": "packages/msw-graphql"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src && node scripts/node-smoke.mjs",
		"test:matrix": "bun run scripts/test-matrix.ts",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/schema/index.ts",
			"src/sdl/index.ts",
			"src/browser/index.ts",
			"src/node/index.ts",
			"src/fetch/index.ts",
			"src/response/index.ts",
			"src/control/index.ts"
		]
	},
	"devDependencies": {
		"@graphql-tools/mock": "^9.1.16",
		"@graphql-tools/schema": "^10.1.3",
		"@types/bun": "^1.4.0",
		"graphql": "^17.0.2",
		"msw": "^3.0.3"
	},
	"peerDependencies": {
		"@graphql-tools/mock": "^9.1.0",
		"@graphql-tools/schema": "^10.0.0",
		"graphql": "^16.0.0 || ^17.0.0",
		"msw": "^2.12.10 || ^3.0.0",
		"typescript": "^6.0.3 || ^7.0.0"
	},
	"peerDependenciesMeta": {
		"@graphql-tools/mock": {
			"optional": true
		},
		"@graphql-tools/schema": {
			"optional": true
		}
	}
}
