{
	"name": "@nxgt/playwright",
	"version": "0.6.0",
	"description": "The Playwright boilerplate every app repeats, written once: a shared config, BasePage and FormPage, login and storage-state fixtures, msw network fixtures, hydration-aware navigation and fills, settled-page waits, axe accessibility checks, Content-Security-Policy checks (refusal guard, nonce on every script), phone projects, full-page screens, PWA specs against a production build (offline, worker updates, cache checks), and Storybook stories as Vitest browser tests with preview capture",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"CHANGELOG.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"import": "./dist/config/index.js",
			"default": "./dist/config/index.js"
		},
		"./pages": {
			"types": "./dist/pages/index.d.ts",
			"import": "./dist/pages/index.js",
			"default": "./dist/pages/index.js"
		},
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"import": "./dist/auth/index.js",
			"default": "./dist/auth/index.js"
		},
		"./helpers": {
			"types": "./dist/helpers/index.d.ts",
			"import": "./dist/helpers/index.js",
			"default": "./dist/helpers/index.js"
		},
		"./a11y": {
			"types": "./dist/a11y/index.d.ts",
			"import": "./dist/a11y/index.js",
			"default": "./dist/a11y/index.js"
		},
		"./csp": {
			"types": "./dist/csp/index.d.ts",
			"import": "./dist/csp/index.js",
			"default": "./dist/csp/index.js"
		},
		"./pwa": {
			"types": "./dist/pwa/index.d.ts",
			"import": "./dist/pwa/index.js",
			"default": "./dist/pwa/index.js"
		},
		"./screens": {
			"types": "./dist/screens/index.d.ts",
			"import": "./dist/screens/index.js",
			"default": "./dist/screens/index.js"
		},
		"./react-router": {
			"types": "./dist/react-router/index.d.ts",
			"import": "./dist/react-router/index.js",
			"default": "./dist/react-router/index.js"
		},
		"./msw": {
			"types": "./dist/msw/index.d.ts",
			"import": "./dist/msw/index.js",
			"default": "./dist/msw/index.js"
		},
		"./storybook": {
			"types": "./dist/storybook/index.d.ts",
			"import": "./dist/storybook/index.js",
			"default": "./dist/storybook/index.js"
		},
		"./storybook/capture": {
			"types": "./dist/storybook/capture.d.ts",
			"import": "./dist/storybook/capture.js",
			"default": "./dist/storybook/capture.js"
		},
		"./storybook/setup": {
			"types": "./dist/storybook/setup.d.ts",
			"import": "./dist/storybook/setup.js",
			"default": "./dist/storybook/setup.js"
		},
		"./mock-server": {
			"types": "./dist/mock-server/index.d.ts",
			"import": "./dist/mock-server/index.js",
			"default": "./dist/mock-server/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"playwright",
		"e2e",
		"page-object",
		"accessibility",
		"axe",
		"msw",
		"storybook",
		"vitest",
		"fixtures",
		"hydration",
		"screenshots",
		"pwa",
		"csp",
		"service-worker",
		"react-router",
		"mock-server"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-devkit.git",
		"directory": "packages/playwright"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src && playwright test -c test/playwright.config.ts && playwright test -c test/playwright.mock-server.config.ts",
		"test:lower-peers": "bun run scripts/test-lower-peers.ts",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/config/index.ts",
			"src/pages/index.ts",
			"src/auth/index.ts",
			"src/helpers/index.ts",
			"src/a11y/index.ts",
			"src/csp/index.ts",
			"src/pwa/index.ts",
			"src/screens/index.ts",
			"src/screens/clear.ts",
			"src/react-router/index.ts",
			"src/msw/index.ts",
			"src/storybook/index.ts",
			"src/storybook/capture.ts",
			"src/storybook/setup.ts",
			"src/mock-server/index.ts"
		],
		"browserOnly": [
			"./storybook/capture",
			"./storybook/setup"
		]
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@msw/playwright": "^0.7.0",
		"@nxgt/msw-graphql": "workspace:^",
		"@playwright/test": "1.64.0",
		"@storybook/addon-vitest": "10.6.0",
		"@types/bun": "^1.4.0",
		"@vitest/browser-playwright": "4.1.10",
		"msw": "^3.0.3",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"@axe-core/playwright": ">=4.10.0 <5",
		"@msw/playwright": ">=0.6.7 <0.8",
		"@playwright/test": "^1.61.0",
		"@storybook/addon-vitest": ">=10.3.0 <11",
		"@vitest/browser-playwright": "^4.0.0",
		"msw": "^2.12.10 || ^3.0.0",
		"typescript": "^6.0.3 || ^7.0.0",
		"vitest": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@axe-core/playwright": {
			"optional": true
		},
		"@msw/playwright": {
			"optional": true
		},
		"@playwright/test": {
			"optional": true
		},
		"@storybook/addon-vitest": {
			"optional": true
		},
		"@vitest/browser-playwright": {
			"optional": true
		},
		"msw": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	}
}
